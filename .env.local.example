# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local (it's gitignored). Add the same vars in
# Vercel -> Project -> Settings -> Environment Variables for production.

# --- Spotify "now playing" ---------------------------------------------------
# 1. https://developer.spotify.com/dashboard -> Create app.
#    Redirect URI: http://127.0.0.1:3000/api/spotify/callback
# 2. Copy Client ID + Client Secret below.
# 3. Get the refresh token: set the two above, restart dev, visit
#    http://127.0.0.1:3000/api/spotify/login and approve — it prints the token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- Steam "recently played" -------------------------------------------------
# 1. Free Web API key: https://steamcommunity.com/dev/apikey
# 2. Your 64-bit SteamID (steamid64) — e.g. paste your profile URL into
#    https://steamid.io and copy the "steamID64" number.
# 3. Steam profile + "game details" privacy must be set to Public.
STEAM_API_KEY=
STEAM_ID=

# --- TMDB (Shows / Movies posters) -------------------------------------------
# Free API key: https://www.themoviedb.org/settings/api  (sign up -> API ->
# create -> use the "API Key (v3 auth)" value).
TMDB_API_KEY=

# --- GitHub (auto-pulled Projects) -------------------------------------------
# OPTIONAL. Without it, the public GitHub API allows 60 requests/hour, which is
# usually fine. A read-only token raises that to 5000/hr.
# Create at https://github.com/settings/tokens (classic, NO scopes needed for
# public repos) or a fine-grained token with read-only public access.
GITHUB_TOKEN=

# --- Tetris leaderboard (Upstash Redis) --------------------------------------
# Free tier: https://upstash.com (or the Vercel Marketplace "Upstash" add-on,
# which sets these automatically). Without them, the leaderboard API routes
# fail soft (score submission/fetching just won't work; the game itself does).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Games login system (Neon Postgres) --------------------------------------
# Free tier: https://neon.tech (or the Vercel Marketplace "Neon" add-on).
# After creating the database, run db/schema.sql once against it (Neon
# console -> SQL Editor). AUTH_SECRET signs session cookies — any long
# random string (e.g. `openssl rand -hex 32`), keep it secret.
DATABASE_URL=
AUTH_SECRET=

# --- Discord leaderboard-announcement bot -------------------------------------
# Public bot that posts to a server's chosen channel whenever a score lands in
# the top 3 on any leaderboard — separate from any single server, installable
# on as many as you want. Setup: https://discord.com/developers/applications ->
# New Application -> Bot tab (reset/copy the bot token) -> General Information
# tab (copy Application ID + Public Key). Interactions Endpoint URL (also on
# the General Information tab) gets set once /api/discord/interactions is
# deployed, not before. Invite link: OAuth2 -> URL Generator -> scope "bot" +
# permission "Send Messages".
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# --- Leaderboard backup cron (/api/cron/leaderboard-backup) ------------------
# Any random string. Vercel automatically sends it as the Authorization
# header for cron-triggered requests when CRON_SECRET is set, which is how
# this route tells a real scheduled run apart from a random public hit on
# the same (guessable) path.
CRON_SECRET=

# --- Health check (/api/health) -----------------------------------------------
# Required for /api/health to respond (it 401s without it) — keeps randoms
# from hitting the endpoint and triggering live calls to every integration.
# Any random string; must match the HEALTH_CHECK_SECRET repo secret used by
# .github/workflows/health-check.yml.
HEALTH_CHECK_SECRET=

